.godot/
.import/
.mono/
/android/

# Local export output
build/
dist/
exports/
web-build/

# GitHub Pages is deployed from a GitHub Actions artifact, not from docs/.
/docs/.nojekyll
/docs/index.html
/docs/404.html
/docs/*.wasm
/docs/*.pck
/docs/*.js
/docs/*.audio.worklet.js
/docs/*.png
/docs/*.svg

# Logs, temp files, and local OS metadata
*.log
*.tmp
*.temp
*.bak
*~
.DS_Store
Thumbs.db

# Editor-local configuration
.idea/
.vscode/
*.code-workspace

# Local AI/agent metadata
.agents/
skills-lock.json

# Local Godot/editor addons
/addons/ziva_agent/

# Local downloaded tools. Keep small portable repository scripts trackable.
/tools/*
!/tools/validate.ps1

